{
  "name": "Supabase Data Fetching Tool",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "query_type"
            },
            {
              "name": "query"
            }
          ]
        }
      },
      "id": "0feab72b-08aa-475b-acfa-d45cb089fc54",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "products",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "ilike",
              "keyValue": "={{ $json.query }}"
            }
          ]
        }
      },
      "id": "71bd3531-eae3-4fea-bf22-8b4da95e847a",
      "name": "Search Products in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "value": "={{ $json }}",
              "type": "object"
            },
            {
              "id": "found",
              "name": "found",
              "value": "={{ $input.all().length > 0 }}",
              "type": "boolean"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ $input.all().length > 0 ? \"Found \" + $input.all().length + \" matching record(s).\" : \"No matching record found.\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "be075d3c-7ebb-411f-81ea-4089d5872199",
      "name": "Format Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Search Products in Supabase",
            "type": "main",
