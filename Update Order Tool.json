        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    order_id: item.order_id || '',\n    full_address: item.full_address || null,\n    product: item.product || null,\n    notes: item.notes || null,\n    city: item.city || null,\n    status: item.status || null,\n    phone_number: item.phone_number || null,\n  }\n}];"
