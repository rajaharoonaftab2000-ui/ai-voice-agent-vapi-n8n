      "id": "8035bb01-5f0f-4bfa-9472-d9fe68886cad",
      "name": "Merge Existing with Updates",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        224,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "const existing = $input.first().json;\nconst updates = $(\"Store Update Inputs\").first().json;\n\n// Start from existing row\nconst merged = {\n  'Order ID': existing['Order ID'],\n  'Timestamp': existing['Timestamp'],\n  'Customer Name': existing['Customer Name'],\n  'Phone Number': existing['Phone Number'],\n  'City': existing['City'],\n  'Full Address': existing['Full Address'],\n  'Product/Order Details': existing['Product/Order Details'],\n  'Order Status': existing['Order Status'],\n  'Notes': existing['Notes'],\n};\n\n// Track which fields were updated\nconst updatedFields = [];\n\n// Only overwrite fields that are explicitly provided (non-null, non-empty)\nif (updates.full_address !== null && updates.full_address !== '') {\n  merged['Full Address'] = updates.full_address;\n  updatedFields.push('Full Address');\n}\nif (updates.product !== null && updates.product !== '') {\n  merged['Product/Order Details'] = updates.product;\n  updatedFields.push('Product/Order Details');\n}\nif (updates.notes !== null && updates.notes !== '') {\n  merged['Notes'] = updates.notes;\n  updatedFields.push('Notes');\n}\nif (updates.city !== null && updates.city !== '') {\n  merged['City'] = updates.city;\n  updatedFields.push('City');\n}\nif (updates.status !== null && updates.status !== '') {\n  merged['Order Status'] = updates.status;\n  updatedFields.push('Order Status');\n}\nif (updates.phone_number !== null && updates.phone_number !== '') {\n  merged['Phone Number'] = updates.phone_number;\n  updatedFields.push('Phone Number');\n}\n\nmerged._updatedFields = updatedFields;\n\nreturn [{ json: merged }];"
      },
