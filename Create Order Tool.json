    {
      "parameters": {
        "jsCode": "const allRows = $input.all();\nlet lastId = 0;\nfor (const row of allRows) {\n  const id = parseInt(row.json['Order ID'], 10);\n  if (!isNaN(id) && id > lastId) {\n    lastId = id;\n  }\n}\nconst nextId = (lastId + 1).toString();\nreturn [{ json: { last_order_id: lastId.toString(), next_order_id: nextId } }];"
      },
